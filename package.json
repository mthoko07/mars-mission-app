{
  "name": "mars-mission-tracker",
  "version": "1.0.0",
  "description": "Task tracker SPA for the Mars mission, bundled with webpack",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "test": "jest",
    "test:e2e": "cypress run",
    "cypress:open": "cypress open"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "cypress": "^16.2.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "start-server-and-test": "^3.0.13",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/tests/styleMock.js"
    }
  }
}
